# Required
DATABASE_URL=postgresql://user:password@localhost:5432/venturepro
JWT_SECRET=change-me-to-a-long-random-string
# Allowed browser origin(s) for CORS; comma-separate several. Default http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Needed for the features that use them (server still boots without them)
ANTHROPIC_API_KEY=
# Only needed if the API key is not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PORT=3001

# Pixabay API key for free stock photos on websites (optional). Without it, empty picture slots stay as blocks.
PIXABAY_API_KEY=
