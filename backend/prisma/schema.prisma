generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password             String
  name                 String?
  plan                 String   @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  subscriptionStatus   String   @default("inactive")
  // The business's Stripe Connect account, used to receive payments from its own customers.
  stripeAccountId      String?
  paymentsEnabled      Boolean  @default(false)
  resetTokenHash       String?  // SHA-256 of the emailed reset token; the token itself is never stored
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  projects   Project[]
  sites      Site[]
  chatUsage  ChatDailyUsage[]
  builds     BuilderProject[]
  assistantThread    AssistantThread?
  assistantProposals AssistantProposal[]
  @@map("users")
}

// One logo or website being built with the AI. Keeps the brief, the current version and what has been asked for so far,
// so later requests build on earlier ones.
model BuilderProject {
  id        String   @id @default(uuid())
  userId    String
  kind      String   // "logo" or "website"
  brief     Json
  state     Json
  history   Json?    // recent requests, replies and changes, oldest first
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("builder_projects")
}

model ChatDailyUsage {
  userId String
  day    String // YYYY-MM-DD in UTC
  count  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("chat_daily_usage")
}

model Site {
  id        String   @id @default(uuid())
  userId    String
  slug      String   @unique
  title     String
  content   Json
  themeId   String   @default("midnight")
  shuffle   Int      @default(0)
  status    String   @default("live")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingSettings Json?
  // The items the owner sells: [{ id, name, description, pricePence }]. Empty or null when there is no shop.
  shopItems Json?
  // The owner's own domain, such as www.yourbusiness.com. It is served only after the DNS checks pass.
  customDomain           String?   @unique
  customDomainToken      String?
  customDomainVerifiedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  shopOrders ShopOrder[]
  @@map("sites")
}

// A paid order from a site's shop. Created when Stripe confirms the payment (by webhook or on the return page).
model ShopOrder {
  id              String   @id @default(uuid())
  siteId          String
  stripeSessionId String   @unique
  itemName        String
  amountPence     Int
  customerName    String
  customerEmail   String
  createdAt       DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@map("shop_orders")
}

model Booking {
  id            String   @id @default(uuid())
  siteId        String
  startsAt      DateTime
  durationMin   Int
  serviceName   String
  customerName  String
  customerEmail String
  customerPhone String   @default("")
  notes         String   @default("")
  status        String   @default("confirmed")
  createdAt     DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Not unique: a class with places can have several people at the same start time. Capacity is checked when booking.
  @@index([siteId, startsAt])
  @@map("bookings")
}

model Project {
  id              String   @id @default(uuid())
  userId          String
  businessName    String?
  niche           String?
  targetAudience  String?
  description     String?
  websiteContent  Json?
  emailTemplates  Json?
  legalDocs       Json?
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("projects")
}

model ChatMessage {
  id         String   @id @default(uuid())
  projectId  String
  userMessage String
  aiResponse String
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Subscription {
  id                  String   @id @default(uuid())
  userId              String
  planType            String
  amountPence         Int
  stripeSubscriptionId String?
  status              String   @default("active")
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  createdAt           DateTime @default(now())

  @@map("subscriptions")
}

// The conversation with the account assistant. Only the most recent messages are kept.
model AssistantThread {
  userId    String   @id
  messages  Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("assistant_threads")
}

// A change the assistant has proposed. Nothing changes on the site until the owner approves it.
model AssistantProposal {
  id        String    @id @default(uuid())
  userId    String
  siteId    String
  summary   String
  before    Json      // the site content when the change was proposed
  after     Json      // the content the change would make
  status    String    @default("pending") // pending, applied, rejected, undone
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("assistant_proposals")
}
